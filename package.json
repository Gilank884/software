{
  "name": "softwarephotobooth",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:main && npm run build:creator",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:3000 && electron .\"",
    "electron:build": "npm run build:main && electron-builder",
    "electron:dist": "npm run build:main && electron-builder --mac",
    "electron:dist:win": "npm run build:main && electron-builder --win",
    "dist:mac:universal": "npm run build:main && electron-builder --mac --universal",
    "build:main": "export VITE_APP_TARGET=main && vite build",
    "build:creator": "export VITE_APP_TARGET=creator && vite build",
    "build:web": "export VITE_DEPLOY=web VITE_APP_TARGET=main && vite build && export VITE_DEPLOY=web VITE_APP_TARGET=creator && vite build"
  },
  "build": {
    "appId": "com.latarcerita.photobooth",
    "productName": "Latarcerita Photobooth",
    "directories": {
      "output": "release"
    },
    "icon": "public/Logo.png",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/**/*",
      "package.json",
      "!node_modules/@tailwindcss/oxide-*",
      "!node_modules/lightningcss-*",
      "!node_modules/tailwindcss",
      "!node_modules/@tailwindcss",
      "!node_modules/postcss",
      "!node_modules/autoprefixer"
    ],
    "mac": {
      "category": "public.app-category.photography",
      "minimumSystemVersion": "10.13.0",
      "hardenedRuntime": true,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "entitlements": "electron/entitlements.mac.plist",
      "entitlementsInherit": "electron/entitlements.mac.plist",
      "extendInfo": {
        "NSCameraUsageDescription": "Latarcerita Photobooth requires access to your camera to take photos.",
        "NSMicrophoneUsageDescription": "Latarcerita Photobooth requires access to your microphone."
      }
    },
    "dmg": {
      "title": "Latarcerita Photobooth",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Latarcerita Photobooth"
    }
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.100.0",
    "electron-is-dev": "^3.0.1",
    "framer-motion": "^12.38.0",
    "lucide-react": "^0.577.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-qr-code": "^2.0.18",
    "selfsigned": "^5.5.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.2.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.27",
    "concurrently": "^9.2.1",
    "electron": "^28.3.3",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.2",
    "vite": "^8.0.1",
    "wait-on": "^9.0.4"
  }
}
